# Supabase Configuration (Phase 1 Foundation)
# Obtain these from your Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key

# Never add service-role, Gemini, Resend, n8n, or database-password secrets to this frontend file.
# Vite deliberately exposes every variable beginning with VITE_ to the browser.
# Store future server-side secrets in Supabase Edge Function secrets or your server environment.
